#!/bin/bash
# TTTTTTT
set -euo pipefail

# === Styling ===
BOLD='\e[1m'
GREEN='\e[92m'
RED='\e[91m'
YELLOW='\e[93m'
BLUE='\e[94m'
CYAN='\e[96m'
RESET='\e[0m'

log() {
  echo -e "${BOLD}${YELLOW}[*] $1${RESET}"
}

info() {
  echo -e "${BOLD}${BLUE}[i] $1${RESET}"
}

warn() {
  echo -e "${BOLD}${CYAN}[!] $1${RESET}"
}

error() {
  echo -e "${BOLD}${RED}[x] $1${RESET}"
}

# === Show available disks ===
show_disks() {
  echo -e "${BOLD}${CYAN}Available disks:${RESET}"
  lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,MODEL 2>/dev/null | grep -E "disk|NAME" | grep -v "loop\|ram\|zram\|dm-\|md\|sr"
  echo
}

# === Ask for disk ===
ask_disk() {
  local disk
  while true; do
    show_disks
    read -rp "$(echo -e ${BOLD}${GREEN}"Enter the disk to install Arch on (e.g., /dev/vda, /dev/sda): "${RESET})" disk
    disk="${disk%/}"
    if [ -b "$disk" ]; then
      echo "$disk"
      return
    else
      error "Disk '$disk' does not exist. Please check and try again."
    fi
  done
}

# === Ask yes/no ===
ask_yes_no() {
  local prompt="$1"
  local default="${2:-no}"
  local reply
  while true; do
    if [ "$default" = "yes" ]; then
      read -rp "$(echo -e ${BOLD}${GREEN}"$prompt (Y/n): "${RESET})" reply
      reply="${reply:-y}"
    else
      read -rp "$(echo -e ${BOLD}${GREEN}"$prompt (y/N): "${RESET})" reply
      reply="${reply:-n}"
    fi
    case "$reply" in
      [Yy]|[Yy][Ee][Ss]) return 0 ;;
      [Nn]|[Nn][Oo]) return 1 ;;
      *) error "Please answer yes or no." ;;
    esac
  done
}

# === Ask for password (hidden input) ===
ask_password() {
  local prompt="$1"
  local default="$2"
  local password
  local confirm
  while true; do
    read -rsp "$(echo -e ${BOLD}${GREEN}"$prompt [$default]: "${RESET})" password
    echo
    if [ -z "$password" ]; then
      password="$default"
    fi
    read -rsp "$(echo -e ${BOLD}${YELLOW}"Confirm password: "${RESET})" confirm
    echo
    if [ "$password" = "$confirm" ]; then
      if [ -z "$password" ]; then
        error "Password cannot be empty."
      else
        echo "$password"
        return
      fi
    else
      error "Passwords do not match. Try again."
    fi
  done
}

# === Ask for hostname ===
ask_hostname() {
  local input
  read -rp "$(echo -e ${BOLD}${GREEN}"Enter hostname [arch]: "${RESET})" input
  if [[ "$input" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]]; then
    echo "$input"
  else
    if [ -z "$input" ]; then
      echo "arch"
    else
      error "Invalid hostname. Using default 'arch'."
      echo "arch"
    fi
  fi
}

# === Ask for username ===
ask_username() {
  local input
  read -rp "$(echo -e ${BOLD}${GREEN}"Enter username [sami]: "${RESET})" input
  if [[ "$input" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
    echo "$input"
  else
    if [ -z "$input" ]; then
      echo "sami"
    else
      error "Invalid username. Using default 'sami'."
      echo "sami"
    fi
  fi
}

# === Ask for timezone ===
ask_timezone() {
  local input
  read -rp "$(echo -e ${BOLD}${GREEN}"Enter timezone [Africa/Tunis]: "${RESET})" input
  if [ -z "$input" ]; then
    echo "Africa/Tunis"
  elif [ -f "/usr/share/zoneinfo/$input" ]; then
    echo "$input"
  else
    error "Timezone not found. Using default 'Africa/Tunis'."
    echo "Africa/Tunis"
  fi
}

# === Ask for locale ===
ask_locale() {
  local input
  read -rp "$(echo -e ${BOLD}${GREEN}"Enter locale [en_US.UTF-8]: "${RESET})" input
  if [ -z "$input" ]; then
    echo "en_US.UTF-8"
  elif locale -a 2>/dev/null | grep -q "^${input}$"; then
    echo "$input"
  else
    error "Locale not found. Using default 'en_US.UTF-8'."
    echo "en_US.UTF-8"
  fi
}

# === Ask for swapfile size ===
ask_swapfile_size() {
  local input
  read -rp "$(echo -e ${BOLD}${GREEN}"Enter swapfile size [2G]: "${RESET})" input
  if [[ "$input" =~ ^[0-9]+[MG]$ ]]; then
    echo "$input"
  else
    if [ -z "$input" ]; then
      echo "2G"
    else
      error "Invalid size. Using default '2G'."
      echo "2G"
    fi
  fi
}

# === Main ===
echo -e "${BOLD}${GREEN}========================================${RESET}"
echo -e "${BOLD}${GREEN}   SBROS Interactive Installer (btrfs)   ${RESET}"
echo -e "${BOLD}${GREEN}========================================${RESET}"
echo

# === Interactive Prompts ===
DISK=$(ask_disk)
info "Selected disk: ${BOLD}${YELLOW}$DISK${RESET}"

# Ask all the questions
if ask_yes_no "Do you want to partition and format the disk?" "no"; then
  DO_PARTITIONING=true
else
  DO_PARTITIONING=false
fi

if ask_yes_no "Enable LUKS encryption on root partition?" "no"; then
  ENABLE_CRYPT=true
else
  ENABLE_CRYPT=false
fi

if ask_yes_no "Enable swapfile?" "yes"; then
  ENABLE_SWAPFILE=true
  SWAPFILE_SIZE=$(ask_swapfile_size)
else
  ENABLE_SWAPFILE=false
  SWAPFILE_SIZE="2G"
fi

HOSTNAME=$(ask_hostname)
USERNAME=$(ask_username)
PASSWORD=$(ask_password "Enter password for $USERNAME and root" "sami1111")
TIMEZONE=$(ask_timezone)
LOCALE=$(ask_locale)

# === Derived variables (SAME AS WORKING SCRIPT) ===
case "$DISK" in
  /dev/nvme*)
    BOOT_PART="${DISK}p1"
    ROOT_PART="${DISK}p2"
    ;;
  /dev/mmcblk*)
    BOOT_PART="${DISK}p1"
    ROOT_PART="${DISK}p2"
    ;;
  *)
    BOOT_PART="${DISK}1"
    ROOT_PART="${DISK}2"
    ;;
esac

MOUNTPOINT="/mnt"

# Convert swap size for dd command
if [ "$ENABLE_SWAPFILE" = true ]; then
  SWAP_SIZE_MB="${SWAPFILE_SIZE%[MG]}"
  if [[ "$SWAPFILE_SIZE" == *G ]]; then
    SWAP_SIZE_MB=$((SWAP_SIZE_MB * 1024))
  fi
fi

# === Summary (SAME AS WORKING SCRIPT) ===
echo
echo -e "${BOLD}${GREEN}=== Installation Summary ===${RESET}"
echo -e "${BOLD}${YELLOW}Disk:            ${RESET}${DISK}"
echo -e "${BOLD}${YELLOW}Hostname:        ${RESET}${HOSTNAME}"
echo -e "${BOLD}${YELLOW}Username:        ${RESET}${USERNAME}"
echo -e "${BOLD}${YELLOW}Timezone:        ${RESET}${TIMEZONE}"
echo -e "${BOLD}${YELLOW}Locale:          ${RESET}${LOCALE}"
echo -e "${BOLD}${YELLOW}Partitioning:    ${RESET}${DO_PARTITIONING}"
echo -e "${BOLD}${YELLOW}Encryption:      ${RESET}${ENABLE_CRYPT}"
echo -e "${BOLD}${YELLOW}Enable Swapfile: ${RESET}${ENABLE_SWAPFILE}"
echo -e "${BOLD}${YELLOW}Swapfile Size:   ${RESET}${SWAPFILE_SIZE}"
echo
echo -e "${BOLD}${RED}WARNING: This will format and install Arch on ${DISK}${RESET}"
echo

if ! ask_yes_no "Proceed with installation?" "no"; then
  echo -e "${BOLD}${RED}Aborting installation.${RESET}"
  exit 1
fi

# === Paths (SAME AS WORKING SCRIPT) ===
SQUASHFS="/run/archiso/bootmnt/arch/x86_64/airootfs.sfs"
VMLINUZ="/run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux"
INITRAMFS="/run/archiso/bootmnt/arch/boot/x86_64/initramfs-linux.img"

# === Partitioning (EXACTLY SAME AS WORKING SCRIPT) ===
if $DO_PARTITIONING; then
  log "Wiping disk and creating new partitions..."
  wipefs -a "$DISK"
  parted --script "$DISK" mklabel msdos
  parted --script "$DISK" mkpart primary ext4 1MiB 513MiB   # /boot
  parted --script "$DISK" mkpart primary btrfs 513MiB 100%  # /
  parted --script "$DISK" set 1 boot on

  mkfs.ext4 -F -L BOOT "$BOOT_PART"
  mkfs.btrfs -f -L ROOT "$ROOT_PART"
fi

if ! $DO_PARTITIONING; then
  log "Formatting boot partition"
  mkfs.ext4 -F -L BOOT "$BOOT_PART"
fi

# === Btrfs subvolumes (EXACTLY SAME AS WORKING SCRIPT) ===
log "Mounting disk temporarily and creating subvolumes"
mount "$ROOT_PART" "$MOUNTPOINT"

echo "==> Deleting @ and @home subvolumes if they exist..."
for sub in @ @home; do
  if btrfs subvolume list "$MOUNTPOINT" | grep -q "path $sub\$"; then
    btrfs subvolume delete "$MOUNTPOINT/$sub"
  fi
done

echo "==> Creating fresh @ and @home subvolumes..."
btrfs subvolume create "$MOUNTPOINT/@"
btrfs subvolume create "$MOUNTPOINT/@home"

# Preserve or recreate @data depending on DO_PARTITIONING
if $DO_PARTITIONING; then
    echo "==> Creating new @data subvolume..."
    btrfs subvolume create "$MOUNTPOINT/@data"
else
    if ! btrfs subvolume list "$MOUNTPOINT" | grep -q "path @data"; then
        echo "==> Creating @data subvolume (not found)..."
        btrfs subvolume create "$MOUNTPOINT/@data"
    else
        echo "==> Keeping existing @data subvolume."
    fi
fi

umount "$MOUNTPOINT"

log "Mounting final subvolumes..."
mount -o compress=zstd,subvol=@ "$ROOT_PART" "$MOUNTPOINT"

log "Extracting root filesystem from SquashFS"
unsquashfs -d "$MOUNTPOINT" "$SQUASHFS"

mount -o compress=zstd,subvol=@home "$ROOT_PART" "$MOUNTPOINT/home"
mkdir -p "$MOUNTPOINT/data"
mount -o compress=zstd,subvol=@data "$ROOT_PART" "$MOUNTPOINT/data"
mount "$BOOT_PART" "$MOUNTPOINT/boot"

echo "==> Layout mounted successfully:"
findmnt -R "$MOUNTPOINT"

echo "==> Done. Root and home formatted. Data preserved unless partitioned."

# === Kernel (EXACTLY SAME AS WORKING SCRIPT) ===
cp "$VMLINUZ" "$INITRAMFS" "$MOUNTPOINT/boot"

log "Preparing chroot environment"
for d in dev proc sys run; do mount --bind /$d "$MOUNTPOINT/$d"; done

# === Chroot (EXACTLY SAME AS WORKING SCRIPT) ===
log "Entering chroot and configuring system"
arch-chroot "$MOUNTPOINT" /bin/bash -e <<EOF
set -euo pipefail

log() {
  echo -e "${BOLD}${YELLOW}[*] \$1${RESET}"
}

log "Setting hostname"
echo "$HOSTNAME" > /etc/hostname

log "Setting timezone and locale"
ln -sf /usr/share/zoneinfo/$TIMEZONE /etc/localtime
hwclock --systohc
sed -i "s/^#\s*$LOCALE/$LOCALE/" /etc/locale.gen
locale-gen
echo "LANG=$LOCALE" > /etc/locale.conf

log "Configuring keyboard layout"
cat > /etc/default/keyboard <<EOL
XKBMODEL="pc105"
XKBLAYOUT="fr"
EOL

log "Fixing mkinitcpio preset..."
rm -f /etc/mkinitcpio.conf.d/archiso.conf
cat > /etc/mkinitcpio.d/linux.preset <<EOL
PRESETS=('default' 'fallback')

ALL_kver='/boot/vmlinuz-linux'

default_image='/boot/initramfs-linux.img'
default_options=''

fallback_image='/boot/initramfs-linux-fallback.img'
fallback_options=''
EOL

log "Generating initramfs"
mkinitcpio -c /etc/mkinitcpio.conf -g /boot/initramfs-linux.img

log "Installing and configuring GRUB"
grub-install --target=i386-pc --recheck "$DISK"
grub-mkconfig -o /boot/grub/grub.cfg

log "Enabling NetworkManager"
systemctl enable NetworkManager || true

if [ "$ENABLE_SWAPFILE" = true ]; then
  log "Creating swapfile"
  if ! grep -q swap /etc/fstab; then
    touch /swapfile
    chattr +C /swapfile
    dd if=/dev/zero of=/swapfile bs=1M count=${SWAP_SIZE_MB} status=progress
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
  fi
fi

log "Configuring ZRAM"
cat > /etc/systemd/zram-generator.conf <<-EOL
[zram0]
zram-size = min(ram / 2, 8192)
EOL

log "Removing liveuser"
if id liveuser &>/dev/null; then
  userdel -rf liveuser 2>/dev/null || true
fi

log "Creating user and setting passwords"
useradd -m -G wheel,docker,audio,video -s /bin/bash "$USERNAME"
echo "$USERNAME:$PASSWORD" | chpasswd
echo "root:$PASSWORD" | chpasswd

log "Setting Fish as default shell for $USERNAME"
chsh -s /usr/bin/fish "$USERNAME"

log "Enabling sudo for wheel group"
sed -i 's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers

log "Creating some directories"
mkdir -p /home/"$USERNAME"/ScanTailor
chown -R "$USERNAME:$USERNAME" /home/"$USERNAME"
chown -R "$USERNAME:$USERNAME" /data

rm -f /usr/share/wayland-sessions/xfce-wayland.desktop
EOF

log "Generating fstab"
genfstab -U "$MOUNTPOINT" >> "$MOUNTPOINT/etc/fstab"

log "Unmounting and cleaning up"
for d in run sys proc dev; do umount -l "$MOUNTPOINT/$d" || true; done
umount -l "$MOUNTPOINT" || true

log "Offline installation complete. Reboot and remove media."
